{
  "name": "@gilbarbara/react-range-slider",
  "version": "0.7.0",
  "description": "A range slider component for React",
  "author": "Gil Barbara <gilbarbara@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gilbarbara/react-range-slider.git"
  },
  "bugs": {
    "url": "https://github.com/gilbarbara/react-range-slider/issues"
  },
  "homepage": "https://github.com/gilbarbara/react-range-slider",
  "keywords": [
    "react",
    "react-component",
    "range",
    "slider"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "files": [
    "esm",
    "lib",
    "src"
  ],
  "types": "esm",
  "sideEffects": false,
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "deepmerge-ts": "^7.1.3"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "^0.8.4",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^0.2.3",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.6",
    "@types/once": "^1.4.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "cross-env": "^7.0.3",
    "del-cli": "^6.0.0",
    "husky": "^9.1.7",
    "is-ci-cli": "^2.2.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-serializer-html": "^7.1.0",
    "jest-watch-typeahead": "^2.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "repo-tools": "^0.3.1",
    "size-limit": "^11.1.6",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc",
    "build:esm": "tsc -m es6 --outDir esm",
    "clean": "del lib/* && del esm/*",
    "watch:cjs": "npm run build:cjs -- -w",
    "watch:esm": "npm run build:esm -- -w",
    "test": "is-ci \"test:coverage\" \"test:watch\"",
    "test:coverage": "jest --bail --coverage",
    "test:watch": "jest --watchAll --verbose",
    "lint": "eslint --ext .ts,.tsx src test",
    "format": "prettier \"**/*.{js,jsx,json,yml,yaml,css,less,scss,ts,tsx,md,graphql,mdx}\" --write",
    "validate": "npm run lint && npm run test:coverage && npm run build && npm run size",
    "size": "size-limit",
    "prepublishOnly": "npm run validate",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "@gilbarbara/eslint-config"
    ],
    "overrides": [
      {
        "files": [
          "test/**/*.ts?(x)"
        ],
        "rules": {
          "@typescript-eslint/ban-ts-comment": "off",
          "no-console": "off",
          "testing-library/no-container": "off",
          "testing-library/no-node-access": "off"
        }
      }
    ]
  },
  "prettier": "@gilbarbara/prettier-config",
  "size-limit": [
    {
      "name": "esm",
      "path": "./esm/index.js",
      "limit": "5 kB"
    },
    {
      "name": "lib",
      "path": "./lib/index.js",
      "limit": "6 kB"
    }
  ]
}
